        "''''\n",
        "Code Name: Minutes to hours and minutes\n",
        "This code is designed to convert minutes into hours+minutes\n",
        "'''\n",
        "minutes= input(\"How many minutes would you like to convert? \")\n",
        "#this line asks the user how many minutes he would like to convert\n",
        "minutes=int(minutes) #turned the string(minutes) into an integer so runs smoothly\n",
        "\n",
        "hour=int(minutes//60)\n",
        "#divides the minutes into hours\n",
        "min=float(minutes % 60) #made min into a float so can calculate the remainder of the equation\n",
        "#divides the minutes by hours and only holds onto the remainder, which gives us the remaining minutes\n",
        "print(f\"Your minutes, {minutes}: are equal to:{hour} hour(s) and {min} minutes\")"
